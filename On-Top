--Crear boton de activacion y desactivacion
local function CreateToggle(parent, text, stateTable, stateKey)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 40)
    btn.BackgroundColor3 = stateTable[stateKey] and Color3.fromRGB(50, 150, 80) or Color3.fromRGB(35, 35, 40)
    btn.Text = text .. " : " .. (stateTable[stateKey] and "ON" or "OFF")
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    Instance.new("UIStroke", btn).Color = Color3.fromRGB(60, 60, 70)

    btn.MouseButton1Click:Connect(function()
        stateTable[stateKey] = not stateTable[stateKey]
        btn.Text = text .. " : " .. (stateTable[stateKey] and "ON" or "OFF")
        TweenService:Create(btn, TweenInfo.new(0.3), {BackgroundColor3 = stateTable[stateKey] and Color3.fromRGB(50, 150, 80) or Color3.fromRGB(35, 35, 40)}):Play()
    end)
end


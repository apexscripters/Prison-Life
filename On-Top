--Cambiar entre las pestañas disponibles
local function SwitchTab(btnObj, pageObj)
    for _, btn in pairs(TabBtns) do
        btn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        btn.TextColor3 = Color3.fromRGB(180, 180, 180)
    end

    for _, page in pairs(Pages) do
        page.Visible = false
    end

    TweenService:Create(btnObj, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 60, 60), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
    pageObj.Visible = true
end


--Ejecutar el sistema de curacion automatica
task.spawn(function()
    while task.wait(0.2) do
        if not Config.AutoHeal then continue end

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")

        if char and hum and root and hum.Health > 0 and hum.Health < 40 then
            local itemsFolder = workspace:FindFirstChild("Prison_ITEMS") and workspace.Prison_ITEMS:FindFirstChild("giver")
            if not itemsFolder then continue end

            local targetFood = nil
            for _, meal in ipairs({"Breakfast", "Lunch", "Dinner"}) do
                local folder = itemsFolder:FindFirstChild(meal)
                if folder then
                    targetFood = folder:FindFirstChildOfClass("Model")
                    if targetFood then break end
                end
            end

            if targetFood then
                local pickup = targetFood:FindFirstChild("ITEMPICKUP") or targetFood
                if pickup and pickup:IsA("BasePart") then
                    local originalCFrame = root.CFrame

                    local plataforma = Instance.new("Part")
                    plataforma.Size = Vector3.new(2, 0.090, 5)
                    plataforma.CFrame = pickup.CFrame * CFrame.new(0, -2, 0)
                    plataforma.Anchored = true
                    plataforma.Transparency = 1
                    plataforma.CanCollide = true
                    plataforma.Color = Color3.fromRGB(0, 0, 0)
                    plataforma.Material = Enum.Material.Neon
                    plataforma.Parent = workspace

                    hum.PlatformStand = true
                    root.CFrame = pickup.CFrame

                    --Ejecutar la interaccion en segundo plano
                    task.spawn(function()
                        pcall(function()
                            Remotes.InteractWithItem:InvokeServer(targetFood)
                        end)
                    end)

                    task.wait(0.1)

                    root.CFrame = originalCFrame
                    hum.PlatformStand = false
                    plataforma:Destroy()

                    task.wait(0.1)

                    --Ejecutar la accion de comer
                    task.spawn(function()
                        pcall(function()
                            Remotes.EatFood:FireServer()
                        end)
                    end)

                    task.wait(1.5)
                end
            end
        end
    end
end)

--Ejecutar el sistema de arresto automatico
task.spawn(function()
    while task.wait(0.2) do
        if not Config.ArrestActive then continue end

        local char = LocalPlayer.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        if not myRoot then continue end

        local myPos = myRoot.Position

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character.Humanoid.Health > 0 then
                local team = plr.Team and plr.Team.Name or ""

                if team == "Criminal" or team == "Criminals" or team == "Prisoners" or team == "Inmates" then
                    local tRoot = plr.Character.HumanoidRootPart

                    if (myPos - tRoot.Position).Magnitude <= Config.Range then
                        --Enviar la accion en una tarea separada
                        task.spawn(function()
                            pcall(function()
                                local ev = Remotes and Remotes:FindFirstChild("ArrestPlayer")

                                if ev then
                                    if ev:IsA("RemoteEvent") then
                                        ev:FireServer(plr, 1)
                                    else
                                        ev:InvokeServer(plr, 1)
                                    end
                                else
                                    workspace.Remote.arrest:InvokeServer(plr.Character.Head)
                                end
                            end)
                        end)
                    end
                end
            end
        end
    end
end)

--Intentar recoger un objeto especifico
local function TryGrabItem(itemName)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character

    if (bp and bp:FindFirstChild(itemName)) or (char and char:FindFirstChild(itemName)) then
        return
    end

    task.spawn(function()
        pcall(function()
            local ev = Remotes and Remotes:FindFirstChild("GiverPressed")

            if itemName == "Hammer" then
                local hammer = ReplicatedStorage:FindFirstChild("Hammer")

                if hammer and ev then
                    ev:FireServer(hammer)
                end
            else
                local giverFolder = workspace:FindFirstChild("Prison_ITEMS") and workspace.Prison_ITEMS:FindFirstChild("giver")

                if giverFolder and giverFolder:FindFirstChild(itemName) then
                    local pickup = giverFolder[itemName]:FindFirstChild("ITEMPICKUP")

                    if pickup then
                        if ev then
                            ev:FireServer(pickup)
                        else
                            workspace.Remote.ItemHandler:InvokeServer(pickup)
                        end
                    end
                end
            end
        end)
    end)
end

--Mantener la recogida automatica de objetos
task.spawn(function()
    while task.wait(1) do
        if Config.ItemActive then
            for itemName, active in pairs(Config.Items) do
                if active then
                    TryGrabItem(itemName)
                end
            end
        end
    end
end)

--Ejecutar el sistema de aura de golpes
local lastPunch = 0

task.spawn(function()
    while task.wait(0.1) do
        if not Config.PunchActive then continue end

        local now = tick()

        if now - lastPunch < Config.PunchCooldown then continue end

        local char = LocalPlayer.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")

        if not myRoot then continue end

        local myPos = myRoot.Position

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character.Humanoid.Health > 0 then
                local tRoot = plr.Character.HumanoidRootPart

                if (myPos - tRoot.Position).Magnitude <= Config.PunchRange then
                    task.spawn(function()
                        pcall(function()
                            local melee = ReplicatedStorage:FindFirstChild("meleeEvent")

                            if melee then
                                melee:FireServer(plr, 1, 1)
                            end
                        end)
                    end)

                    lastPunch = now
                    break
                end
            end
        end
    end
end)
